# Marketing Brain v1.0.0 — Environment Variables
# Copy to .env and fill in your credentials.
# App shell validates this file on boot (ConfigService / EnvValidator).

# --- App / HTTP shell ---
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# MARKETING_BRAIN_STRICT_ENV=false

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Ads (MCP provider) ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional MCC login customer id
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Smoke / CI without live OAuth:
# GOOGLE_ADS_SKIP_AUTH_VALIDATE=true
# GOOGLE_ADS_FORCE_MOCK=true
# Live account (OAuth refresh + Google Ads API):
# GOOGLE_ADS_LIVE_AUTH=1
# GOOGLE_ADS_LIVE_AUTH=0

# --- Meta Ads (Facebook / Instagram) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# META_SKIP_AUTH_VALIDATE=true
# META_FORCE_MOCK=true

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_STUB=true
# WHATSAPP_VERIFY_TOKEN=

# --- Database ---
# memory | sqlite | postgres
DATABASE_MODE=memory

# --- Optional Firebase (production persistence) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- Ops / scripts ---
# SKIP_DOTENV_FILE=true
