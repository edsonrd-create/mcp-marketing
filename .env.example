# Marketing Brain v1.1 LTS — Environment Variables
# Copy to .env and fill in your credentials.
# App shell validates this file on boot (ConfigService / EnvValidator).

# --- App / HTTP shell ---
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# MARKETING_BRAIN_STRICT_ENV=false

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Ads ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Set true for smoke tests without live OAuth validation
# GOOGLE_ADS_SKIP_AUTH_VALIDATE=true
# GOOGLE_ADS_LIVE_AUTH=0

# --- Meta Ads (Facebook / Instagram) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# META_APP_ID=
# META_APP_SECRET=
# META_SKIP_AUTH_VALIDATE=true

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_STUB=true

# --- Database ---
# memory | sqlite | postgres
DATABASE_MODE=memory

# --- Optional Firebase (production persistence) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- Ops / scripts ---
# SKIP_DOTENV_FILE=true
