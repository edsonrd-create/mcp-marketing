{
  "name": "mcp-marketing",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Marketing Brain v1.1 LTS — plataforma MCP instalável: Google Ads, Meta Ads, WhatsApp, Insights, AI Agent, Workflows",
  "bin": {
    "marketing-brain": "./packages/cli/bin/marketing-brain.js",
    "create-marketing-brain": "./packages/create-marketing-brain/bin/create-marketing-brain.js"
  },
  "workspaces": [
    "shared",
    "mcp-google-ads",
    "mcp-meta-ads",
    "mcp-whatsapp",
    "mcp-insights",
    "mcp-ai-agent",
    "mcp-workflows",
    "packages/cli",
    "packages/create-marketing-brain"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @mcp-marketing/shared && npm run build -w @mcp-marketing/google-ads && npm run build -w @mcp-marketing/meta-ads && npm run build -w @mcp-marketing/whatsapp && npm run build -w @mcp-marketing/insights && npm run build -w @mcp-marketing/ai-agent && npm run build -w @mcp-marketing/workflows",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "node scripts/system-validation.mjs",
    "doctor": "node scripts/doctor.mjs",
    "status": "node scripts/status.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "mcp:tools": "node scripts/mcp-tools.mjs",
    "live:validate": "node scripts/live-validation.mjs",
    "workflows:run": "node scripts/workflows-run.mjs",
    "build:info": "node scripts/build-info.mjs",
    "package:release": "node scripts/package-release.mjs",
    "marketing-brain": "node packages/cli/bin/marketing-brain.js",
    "create-marketing-brain": "node packages/create-marketing-brain/bin/create-marketing-brain.js",
    "dev:google": "npm run dev -w @mcp-marketing/google-ads",
    "dev:meta": "npm run dev -w @mcp-marketing/meta-ads",
    "dev:whatsapp": "npm run dev -w @mcp-marketing/whatsapp",
    "dev:insights": "npm run dev -w @mcp-marketing/insights",
    "dev:ai-agent": "npm run dev -w @mcp-marketing/ai-agent",
    "dev:workflows": "npm run dev -w @mcp-marketing/workflows",
    "start:google": "npm run start -w @mcp-marketing/google-ads",
    "start:meta": "npm run start -w @mcp-marketing/meta-ads",
    "start:whatsapp": "npm run start -w @mcp-marketing/whatsapp",
    "start:insights": "npm run start -w @mcp-marketing/insights",
    "start:ai-agent": "npm run start -w @mcp-marketing/ai-agent",
    "start:workflows": "npm run start -w @mcp-marketing/workflows"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
