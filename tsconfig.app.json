{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-app",
    "rootDir": "src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"],
  "references": [{ "path": "./shared" }]
}
